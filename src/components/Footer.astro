---
import { SITE } from '../site';
---
<footer class="border-t border-line mt-28">
  <div class="wrap py-12 grid gap-10 md:grid-cols-[1.4fr_1fr_1fr]">
    <div>
      <p class="font-serif text-2xl uppercase tracking-[0.08em]"><em>Reforming</em> <span class="text-accent-soft">USA</span></p>
      <p class="mt-3 text-muted max-w-sm">{SITE.tagline}</p>
    </div>
    <nav aria-label="Footer">
      <h2 class="eyebrow">Explore</h2>
      <ul class="mt-4 space-y-2 text-muted">
        <li><a href="/#mission" class="hover:text-bone no-underline">Mission</a></li>
        <li><a href="/#explore" class="hover:text-bone no-underline">Explore</a></li>
      </ul>
    </nav>
    <div>
      <h2 class="eyebrow">Follow</h2>
      <ul class="mt-4 space-y-2 text-muted">
        {SITE.social.map((s) => <li><a href={s.href} rel="noopener" class="hover:text-bone no-underline">{s.label}</a></li>)}
        {SITE.email && <li><a href={`mailto:${SITE.email}`} class="hover:text-bone no-underline">{SITE.email}</a></li>}
      </ul>
    </div>
  </div>
  <div class="border-t border-line">
    <p class="wrap py-6 text-sm text-muted">© {new Date().getFullYear()} Reforming USA · A <a href={SITE.parent.href} class="text-bone">{SITE.parent.name}</a> project</p>
  </div>
</footer>
