# Where the newsletter form POSTs. Use your provider's HTML-form action URL.
# Beehiiv:    https://embeds.beehiiv.com/<form-id>/subscribe   (check your embed code)
# ConvertKit: https://app.kit.com/forms/<form-id>/subscriptions
# Substack:   https://<yourpub>.substack.com/api/v1/free?nojs=true
PUBLIC_NEWSLETTER_ENDPOINT=
# Name of the email field your provider expects (Beehiiv/Substack: email, ConvertKit: email_address)
PUBLIC_NEWSLETTER_EMAIL_FIELD=email
